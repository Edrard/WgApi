{
    "name": "edrard/wgapi",
    "description": "Single-URL World of Tanks API builder for PHP 8.5",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-filter": "*"
    },
    "autoload": {
        "psr-4": {
            "edrard\\WgApi\\": "src/WgApi/"
        }
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edrard"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "edrard\\Tests\\WgApi\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "homepage": "https://github.com/Edrard/WgApi",
    "support": {
        "source": "https://github.com/Edrard/WgApi",
        "issues": "https://github.com/Edrard/WgApi/issues"
    }
}
